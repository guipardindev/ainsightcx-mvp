# Chave da API da Groq — obtenha em https://console.groq.com/keys
# Usada apenas no servidor (Route Handlers). Nunca é exposta ao browser.
GROQ_API_KEY=gsk_sua_chave_aqui

# Opcional: URL pública do deploy, usada nas metatags Open Graph.
# Na Vercel isso é detectado automaticamente — só preencha se quiser fixar.
# NEXT_PUBLIC_SITE_URL=https://ainsightcx-mvp.vercel.app
